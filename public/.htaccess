<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forcer HTTPS — méthode officielle recommandée par OVHcloud pour
  # l'hébergement mutualisé (%{SERVER_PORT} est fiable sur cette
  # infrastructure, contrairement à %{HTTPS}) :
  # https://docs.ovhcloud.com/fr/guides/web-cloud/web-hosting/htaccess-url-rewriting-using-mod-rewrite
  RewriteCond %{SERVER_PORT} 80
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=302,L]

  # Servir directement les fichiers et dossiers existants (JS, CSS, images, favicon…)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Toutes les autres routes → index.html (React Router prend la main)
  RewriteRule ^ /index.html [L]
</IfModule>
